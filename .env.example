DATABASE_URL=postgresql://bu_site:change-me@127.0.0.1:5432/bu_site
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://127.0.0.1:3847
# Set true when the public site is served over https.
COOKIE_SECURE=

# Used only by prisma/seed.ts, and only if this email does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Enquiries are saved either way. Mail is sent when these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Optional. The honeypot is always on. Turnstile runs only when both keys are set.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
